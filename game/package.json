{
  "name": "globe-rush",
  "private": true,
  "version": "0.1.0",
  "description": "A Worldwide Rush–style transport tycoon on a 3D globe (Vite + TypeScript + three.js + three-globe)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
